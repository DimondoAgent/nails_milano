__pycache__/
*.py[cod]
*.pyo
 
# Виртуальное окружение
venv/
.venv/
env/
 
# Секреты — никогда в образ
.env
 
# Git
.git/
.gitignore
 
# IDE
.idea/
.vscode/
 
# macOS
.DS_Store
 
# Документация
*.md
 